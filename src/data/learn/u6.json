   "dialogue": {
    "scene": "What's for lunch?",
    "lines": [
     {
      "who": "Arun",
      "od": "ଲିପି, ଆଜି କ'ଣ ଖାଇବା?",
      "tr": "Lipi, aji kana khaiba?",
      "en": "Lipi, what are we eating today?"
     },
     {
      "who": "Lipi",
      "od": "ଭାତ, ଡାଲି ଆଉ ମାଛ ତରକାରୀ।",
      "tr": "bhata, dali au machha tarakari.",
      "en": "Rice, dal and fish curry."
     },
     {
      "who": "Arun",
      "od": "ପଖାଳ ନାହିଁ?",
      "tr": "pakhala nahin?",
      "en": "No pakhala?"
     },
     {
      "who": "Lipi",
      "od": "ଆଜି ନାହିଁ, କାଲି ପଖାଳ।",
      "tr": "aji nahin, kali pakhala.",
      "en": "Not today, pakhala tomorrow."
     },
     {
      "who": "Arun",
      "od": "ଠିକ୍ ଅଛି। ଗୋଟେ ଚା ମିଳିବ?",
      "tr": "thik achhi. gote cha miliba?",
      "en": "OK. Can I get a tea?"
     },
     {
      "who": "Lipi",
      "od": "ହଁ, ଚା ଆଉ ଚୁଡ଼ା ଭଜା ଅଛି।",
      "tr": "han, cha au chura bhaja achhi.",
      "en": "Yes, there's tea and fried flattened rice."
     }
    ]
   },
   "tip": {
    "title": "ଭାତ means more than rice",
    "text": "ଭାତ is cooked rice, and since rice is at the centre of most Odia meals it often just means 'a meal'. ଭାତ ଖାଇଲ? (lit. 'did you eat rice?') is a friendly way to ask whether someone has had lunch or dinner. Uncooked rice has its own word: ଚାଉଳ."
   }
