   "dialogue": {
    "scene": "Counting mangoes",
    "lines": [
     {
      "who": "Mama",
      "od": "ଲିପି, ଆମ୍ବ ଗଣ ତ!",
      "tr": "Lipi, amba gana ta!",
      "en": "Lipi, count the mangoes!"
     },
     {
      "who": "Lipi",
      "od": "ଏକ, ଦୁଇ, ତିନି, ଚାରି, ପାଞ୍ଚ…",
      "tr": "eka, dui, tini, chari, pancha…",
      "en": "One, two, three, four, five…"
     },
     {
      "who": "Lipi",
      "od": "ଛଅ, ସାତ, ଆଠ। ଆଠଟି ଆମ୍ବ!",
      "tr": "chhaa, sata, atha. athati amba!",
      "en": "Six, seven, eight. Eight mangoes!"
     },
     {
      "who": "Mama",
      "od": "ନା, ଆଉ ଥରେ ଗଣ।",
      "tr": "na, au thare gana.",
      "en": "No, count again."
     },
     {
      "who": "Lipi",
      "od": "… ନଅ, ଦଶ! ଦଶଟି ଆମ୍ବ।",
      "tr": "… naa, dasa! dasati amba.",
      "en": "… nine, ten! Ten mangoes."
     },
     {
      "who": "Mama",
      "od": "ବହୁତ ଭଲ!",
      "tr": "bahut bhala!",
      "en": "Very good!"
     }
    ]
   },
   "tip": {
    "title": "Counting things and people",
    "text": "When you count things, add ଟି or ଟା to the number: ଦୁଇଟା ଚା (two teas), ଦଶଟି ଆମ୍ବ (ten mangoes). For people, use ଜଣ: ଛଅ ଜଣ (six people). 'One thing' is ଗୋଟିଏ, and 'one person' is ଜଣେ. You will also see Odia digits ୧ ୨ ୩ … on signs and calendars."
   }
